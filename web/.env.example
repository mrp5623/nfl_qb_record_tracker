# The publishable key is safe to expose -- it is shipped to the browser by
# design, and every table it can reach is protected by the read-only RLS
# policies in db/migrations/schema2_rls.sql.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
